<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:">
<meta name="generator" content="Ta-Da">
<title>{{.Title}}</title>
<style>
:root {
  --bg: #fbfaf8;
  --surface: #ffffff;
  --surface-2: #f4f2ee;
  --border: #e5e1da;
  --text: #1f1d1a;
  --muted: #6d675f;
  --accent: #5b3ff0;
  --accent-soft: #efebff;
  --code-bg: #f5f3ef;
  --add-bg: #e7f6eb;
  --add-fg: #17713a;
  --del-bg: #fdeceb;
  --del-fg: #b3261e;
  --warn-bg: #fff5dc;
  --warn-fg: #7f5400;
  --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  --sans: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #141317;
    --surface: #1c1b20;
    --surface-2: #25242a;
    --border: #35333c;
    --text: #ebe8f0;
    --muted: #9c97a6;
    --accent: #a596ff;
    --accent-soft: #252040;
    --code-bg: #111014;
    --add-bg: #12301e;
    --add-fg: #74d995;
    --del-bg: #3b1618;
    --del-fg: #ff8f86;
    --warn-bg: #332810;
    --warn-fg: #f2c25c;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font: 15px/1.6 var(--sans);
  overflow-wrap: anywhere;
}
main { max-width: 880px; margin: 0 auto; padding: 32px 16px 48px; }
a { color: var(--accent); }
code, pre, kbd { font-family: var(--mono); font-size: 13px; }
:not(pre) > code {
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 0 4px;
}
pre {
  margin: 0;
  padding: 12px 14px;
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow-x: auto;
  line-height: 1.5;
  overflow-wrap: normal;
}
pre code { background: none; border: 0; padding: 0; white-space: pre; }

.head { margin-bottom: 28px; }
.eyebrow {
  margin: 0 0 4px;
  color: var(--muted);
  font-size: 12px;
  letter-spacing: .08em;
  text-transform: uppercase;
}
h1 { margin: 0 0 18px; font-size: 26px; line-height: 1.25; }
.meta {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 1px;
  margin: 0;
  background: var(--border);
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
}
.meta div { background: var(--surface); padding: 10px 14px; min-width: 0; }
.meta dt { color: var(--muted); font-size: 12px; }
.meta dd { margin: 0; font-weight: 600; }
.files { margin-top: 18px; }
.files h2, .network h2 { font-size: 15px; margin: 0 0 8px; }

details {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  margin: 10px 0;
}
details > summary {
  display: flex;
  align-items: baseline;
  gap: 8px;
  padding: 8px 12px;
  cursor: pointer;
  list-style: none;
  min-width: 0;
}
details > summary::-webkit-details-marker { display: none; }
details > summary::before {
  content: "▸";
  color: var(--muted);
  flex: none;
  transition: transform .15s;
}
details[open] > summary::before { transform: rotate(90deg); }
details[open] > summary { border-bottom: 1px solid var(--border); }
.body { padding: 10px 12px 12px; }
.body > * + * { margin-top: 10px; }
.label { color: var(--muted); font-size: 12px; margin: 0; }
.tag {
  flex: none;
  font: 600 12px/1.6 var(--mono);
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: 4px;
  padding: 0 6px;
}
.what {
  flex: 1;
  min-width: 0;
  color: var(--muted);
  font-family: var(--mono);
  font-size: 13px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.stat { flex: none; font: 12px var(--mono); }
.add { color: var(--add-fg); }
.del { color: var(--del-fg); }
.failed { flex: none; font-size: 12px; font-weight: 600; color: var(--del-fg); }
.tool.error { border-color: var(--del-fg); }
.more { color: var(--muted); font-size: 13px; font-style: italic; }

pre.diff { padding: 8px 0; }
pre.diff span { display: block; padding: 0 14px; min-width: max-content; }
pre.diff .a { background: var(--add-bg); color: var(--add-fg); }
pre.diff .d { background: var(--del-bg); color: var(--del-fg); }
pre.diff .h { color: var(--accent); }

.turns { list-style: none; margin: 0; padding: 0; }
.turn { margin: 0 0 22px; }
.who {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 6px;
  font-size: 13px;
  color: var(--muted);
}
.role { font-weight: 700; color: var(--text); }
.model { font-family: var(--mono); font-size: 12px; }
.turn.user .content {
  background: var(--accent-soft);
  border-radius: 10px;
  padding: 10px 14px;
}
.turn.summary .content {
  border: 1px dashed var(--border);
  border-radius: 10px;
  padding: 10px 14px;
}
.prose > :first-child { margin-top: 0; }
.prose > :last-child { margin-bottom: 0; }
.prose p, .prose ul, .prose ol, .prose pre, .prose table, .prose blockquote { margin: 0 0 10px; }
.prose h1, .prose h2, .prose h3, .prose h4 { margin: 16px 0 8px; line-height: 1.3; }
.prose h1 { font-size: 20px; }
.prose h2 { font-size: 18px; }
.prose h3, .prose h4 { font-size: 16px; }
.prose blockquote { border-left: 3px solid var(--border); padding-left: 12px; color: var(--muted); }
.prose table { border-collapse: collapse; display: block; overflow-x: auto; }
.prose th, .prose td { border: 1px solid var(--border); padding: 4px 10px; }
.prose .img { color: var(--muted); font-style: italic; }
.reasoning .prose { color: var(--muted); }
.notice {
  background: var(--warn-bg);
  color: var(--warn-fg);
  border-radius: 8px;
  padding: 8px 12px;
  margin: 10px 0;
  font-size: 14px;
}
.attachment { color: var(--muted); font-size: 14px; margin: 6px 0; }
.shell .exit { color: var(--del-fg); font-size: 13px; }

.network table { width: 100%; border-collapse: collapse; font-size: 13px; overflow-wrap: normal; }
.network th, .network td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border); }
.network td.n, .network th.n { text-align: right; white-space: nowrap; }
.network .scroll { overflow-x: auto; }
footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--border); color: var(--muted); font-size: 13px; }
footer .network { margin-bottom: 16px; color: var(--text); }

@media (max-width: 520px) {
  body { font-size: 14px; }
  main { padding-top: 20px; }
  h1 { font-size: 22px; }
}
</style>
</head>
<body>
<main>
<header class="head">
<p class="eyebrow">Ta-Da session</p>
<h1>{{.Title}}</h1>
<dl class="meta">
{{- range .Meta}}
<div><dt>{{.Label}}</dt><dd>{{.Value}}</dd></div>
{{- end}}
</dl>
{{- if .Files}}
<section class="files">
<h2>Files changed</h2>
{{- range .Files}}
<details class="file">
<summary><code class="what">{{.Path}}</code><span class="stat"><span class="add">+{{.Additions}}</span> <span class="del">−{{.Removals}}</span></span></summary>
<div class="body">
{{template "diff" .Diff}}
</div>
</details>
{{- end}}
</section>
{{- end}}
</header>
<ol class="turns">
{{- range .Turns}}
<li class="turn {{.Class}}">
<div class="who"><span class="role">{{.Label}}</span>{{if .Clock}}<time>{{.Clock}}</time>{{end}}{{if .Model}}<span class="model">{{.Model}}</span>{{end}}</div>
<div class="content">
{{- range .Blocks}}
{{- if eq .Kind "text"}}
<div class="prose">{{.HTML}}</div>
{{- else if eq .Kind "reasoning"}}
<details class="reasoning">
<summary><span class="what">Thinking</span></summary>
<div class="body prose">{{.HTML}}</div>
</details>
{{- else if eq .Kind "tool"}}{{with .Tool}}
<details class="tool{{if .IsError}} error{{end}}">
<summary><span class="tag">{{.Name}}</span><span class="what">{{.Summary}}</span>{{if .HasDiff}}<span class="stat"><span class="add">+{{.Additions}}</span> <span class="del">−{{.Removals}}</span></span>{{end}}{{if .IsError}}<span class="failed">failed</span>{{end}}</summary>
<div class="body">
{{- if .HasDiff}}
<p class="label">Changes to <code>{{.DiffPath}}</code></p>
{{template "diff" .Diff}}
{{- else if .Input}}
<p class="label">Input</p>
<pre><code>{{.Input}}</code></pre>
{{- end}}
{{- if .NoResult}}
<p class="more">No result was recorded.</p>
{{- else if .Result}}
<p class="label">{{if .IsError}}Error{{else}}Result{{end}}</p>
<pre><code>{{.Result}}</code></pre>
{{- if .ResultMore}}
<p class="more">{{.ResultMore}}</p>
{{- end}}
{{- end}}
</div>
</details>
{{- end}}
{{- else if eq .Kind "shell"}}{{with .Shell}}
<div class="shell">
<pre><code>$ {{.Command}}{{if .Output}}
{{.Output}}{{end}}</code></pre>
{{- if .More}}
<p class="more">{{.More}}</p>
{{- end}}
{{- if .ExitCode}}
<p class="exit">Exited with status {{.ExitCode}}.</p>
{{- end}}
</div>
{{- end}}
{{- else if eq .Kind "attachment"}}
<p class="attachment">Attached: {{.Text}}</p>
{{- else if eq .Kind "notice"}}
<p class="notice">{{.Text}}</p>
{{- end}}
{{- end}}
</div>
</li>
{{- end}}
</ol>
<footer>
{{- if .Hosts}}
<section class="network">
<h2>Network</h2>
<div class="scroll">
<table>
<thead><tr><th>Host</th><th>Used for</th><th class="n">Requests</th><th class="n">Sent</th><th class="n">Received</th></tr></thead>
<tbody>
{{- range .Hosts}}
<tr><td><code>{{.Host}}</code>{{if .Local}} (local){{end}}</td><td>{{.Purposes}}</td><td class="n">{{.Requests}}</td><td class="n">{{.Sent}}</td><td class="n">{{.Received}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
</section>
{{- end}}
<p>{{.Footer}}</p>
</footer>
</main>
</body>
</html>
{{define "diff"}}<pre class="diff"><code>{{range .Lines}}<span{{if .Class}} class="{{.Class}}"{{end}}>{{.Text}}</span>{{end}}</code></pre>{{if .More}}
<p class="more">{{.More}}</p>{{end}}{{end}}
