.prose blockquote { border-left: 3px solid var(--border); padding-left: 12px; color: var(--muted); }
.prose table { border-collapse: collapse; display: block; overflow-x: auto; }
.prose th, .prose td { border: 1px solid var(--border); padding: 4px 10px; }
.prose .img { color: var(--muted); font-style: italic; }
.reasoning .prose { color: var(--muted); }
.notice {
  background: var(--warn-bg);
  color: var(--warn-fg);
